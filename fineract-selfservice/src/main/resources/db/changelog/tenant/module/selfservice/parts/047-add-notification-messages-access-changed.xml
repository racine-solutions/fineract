<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <!-- Message sent by email AND SMS whenever staff change a client's mobile app access. -->
    <changeSet author="racine" id="ss-0047-access-changed-1">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM m_template WHERE name = 'SELF_SERVICE_ACCESS_CHANGED_EMAIL_SUBJECT'</sqlCheck>
        </preConditions>
        <insert tableName="m_template">
            <column name="entity" valueNumeric="0"/>
            <column name="type" valueNumeric="1"/>
            <column name="name" value="SELF_SERVICE_ACCESS_CHANGED_EMAIL_SUBJECT"/>
            <column name="text" value="Your mobile app access has changed"/>
        </insert>
    </changeSet>
    <changeSet author="racine" id="ss-0047-access-changed-2">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM m_template WHERE name = 'SELF_SERVICE_ACCESS_CHANGED_EMAIL'</sqlCheck>
        </preConditions>
        <insert tableName="m_template">
            <column name="entity" valueNumeric="0"/>
            <column name="type" valueNumeric="1"/>
            <column name="name" value="SELF_SERVICE_ACCESS_CHANGED_EMAIL"/>
            <column name="text" value="Hello ${firstname} ${lastname}, ${accessChange} Reason: ${reason}. If you did not expect this change, please contact your branch."/>
        </insert>
    </changeSet>
    <changeSet author="racine" id="ss-0047-access-changed-3">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM m_template WHERE name = 'SELF_SERVICE_ACCESS_CHANGED_SMS'</sqlCheck>
        </preConditions>
        <insert tableName="m_template">
            <column name="entity" valueNumeric="0"/>
            <column name="type" valueNumeric="1"/>
            <column name="name" value="SELF_SERVICE_ACCESS_CHANGED_SMS"/>
            <column name="text" value="Hi ${firstname}, ${accessChange} Reason: ${reason}. Questions? Contact your branch."/>
        </insert>
    </changeSet>
    <changeSet author="racine" id="ss-0047-access-changed-4">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM m_template WHERE name = 'SELF_SERVICE_ACCESS_CHANGED_WHATSAPP'</sqlCheck>
        </preConditions>
        <insert tableName="m_template">
            <column name="entity" valueNumeric="0"/>
            <column name="type" valueNumeric="1"/>
            <column name="name" value="SELF_SERVICE_ACCESS_CHANGED_WHATSAPP"/>
            <column name="text" value="Hi ${firstname}, ${accessChange} Reason: ${reason}. Questions? Contact your branch."/>
        </insert>
    </changeSet>
    <changeSet author="racine" id="ss-0047-access-changed-5">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM m_template WHERE name = 'SELF_SERVICE_ACCESS_CHANGED_IN_APP'</sqlCheck>
        </preConditions>
        <insert tableName="m_template">
            <column name="entity" valueNumeric="0"/>
            <column name="type" valueNumeric="1"/>
            <column name="name" value="SELF_SERVICE_ACCESS_CHANGED_IN_APP"/>
            <column name="text" value="${accessChange} Reason: ${reason}."/>
        </insert>
    </changeSet>
</databaseChangeLog>
