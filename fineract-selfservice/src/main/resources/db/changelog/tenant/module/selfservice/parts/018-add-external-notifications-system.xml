<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet author="fineract" id="ss-0018-1">
        <preConditions onFail="MARK_RAN">
            <and>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM c_external_service WHERE name = 'NotificationsService'
                </sqlCheck>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM c_external_service_properties
                    WHERE external_service_id = (SELECT id FROM c_external_service WHERE name = 'NotificationsService')
                </sqlCheck>
            </and>
        </preConditions>

        <comment>Adding NotificationsService to external services and its properties</comment>

        <insert tableName="c_external_service">
            <column name="name" value="NotificationsService"/>
        </insert>

        <insert tableName="c_external_service_properties">
            <column name="name" value="host"/>
            <column name="value" value="https://apis.mifos.community/1.0/notifications"/>
            <column name="external_service_id" valueComputed="(SELECT id FROM c_external_service WHERE name = 'NotificationsService')"/>
        </insert>

        <insert tableName="c_external_service_properties">
            <column name="name" value="header"/>
            <column name="value" value="X-Gravitee-Api-Key"/>
            <column name="external_service_id" valueComputed="(SELECT id FROM c_external_service WHERE name = 'NotificationsService')"/>
        </insert>

        <insert tableName="c_external_service_properties">
            <column name="name" value="headerValue"/>
            <column name="value" value="0000-0000-0000-0000"/>
            <column name="external_service_id" valueComputed="(SELECT id FROM c_external_service WHERE name = 'NotificationsService')"/>
        </insert>

        <insert tableName="c_external_service_properties">
            <column name="name" value="httpMethod"/>
            <column name="value" value="POST"/>
            <column name="external_service_id" valueComputed="(SELECT id FROM c_external_service WHERE name = 'NotificationsService')"/>
        </insert>

        <insert tableName="c_external_service_properties">
            <column name="name" value="isEmail"/>
            <column name="value" value="false"/>
            <column name="external_service_id" valueComputed="(SELECT id FROM c_external_service WHERE name = 'NotificationsService')"/>
        </insert>

        <insert tableName="c_external_service_properties">
            <column name="name" value="isSms"/>
            <column name="value" value="false"/>
            <column name="external_service_id" valueComputed="(SELECT id FROM c_external_service WHERE name = 'NotificationsService')"/>
        </insert>

        <insert tableName="c_external_service_properties">
            <column name="name" value="isWhatsapp"/>
            <column name="value" value="false"/>
            <column name="external_service_id" valueComputed="(SELECT id FROM c_external_service WHERE name = 'NotificationsService')"/>
        </insert>

        <insert tableName="c_external_service_properties">
            <column name="name" value="isInApp"/>
            <column name="value" value="false"/>
            <column name="external_service_id" valueComputed="(SELECT id FROM c_external_service WHERE name = 'NotificationsService')"/>
        </insert>

        <insert tableName="c_external_service_properties">
            <column name="name" value="isEnabled"/>
            <column name="value" value="false"/>
            <column name="external_service_id" valueComputed="(SELECT id FROM c_external_service WHERE name = 'NotificationsService')"/>
        </insert>

        <rollback>
            <delete tableName="c_external_service_properties">
                <where>external_service_id = (SELECT id FROM c_external_service WHERE name = 'NotificationsService')</where>
            </delete>
            <delete tableName="c_external_service">
                <where>name = 'NotificationsService'</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
