<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- Password Reset Requested - Notification Templates -->
    <changeSet author="fineract" id="ss-0039-1">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*)
                FROM m_template
                WHERE name IN (
                    'SELF_SERVICE_PASSWORD_RESET_REQUESTED_EMAIL_SUBJECT',
                    'SELF_SERVICE_PASSWORD_RESET_REQUESTED_EMAIL',
                    'SELF_SERVICE_PASSWORD_RESET_REQUESTED_SMS',
                    'SELF_SERVICE_PASSWORD_RESET_REQUESTED_WHATSAPP',
                    'SELF_SERVICE_PASSWORD_RESET_REQUESTED_IN_APP'
                );
            </sqlCheck>
        </preConditions>

        <comment>Notification templates for PASSWORD_RESET_REQUESTED event (Email, SMS, WhatsApp, In-App)</comment>

        <!-- ============================================================ -->
        <!-- EMAIL Templates (type = 1)                                   -->
        <!-- ============================================================ -->

        <!-- Email Subject -->
        <insert tableName="m_template">
            <column name="entity" valueNumeric="0"/>
            <column name="type" valueNumeric="1"/>
            <column name="name" value="SELF_SERVICE_PASSWORD_RESET_REQUESTED_EMAIL_SUBJECT"/>
            <column name="text" value="Restablecimiento de Contraseña - Código de Verificación"/>
        </insert>

        <!-- Email Body (HTML) -->
        <insert tableName="m_template">
            <column name="entity" valueNumeric="0"/>
            <column name="type" valueNumeric="1"/>
            <column name="name" value="SELF_SERVICE_PASSWORD_RESET_REQUESTED_EMAIL"/>
            <column name="text" value="&lt;p&gt;Hola ${firstname},&lt;/p&gt;&lt;p&gt;Hemos recibido una solicitud para restablecer la contraseña de tu cuenta &lt;strong&gt;${username}&lt;/strong&gt;.&lt;/p&gt;&lt;p&gt;Tu código de verificación es:&lt;/p&gt;&lt;h2 style=&quot;background-color:#f4f4f4;padding:15px;text-align:center;letter-spacing:5px;font-family:monospace;&quot;&gt;${authCode}&lt;/h2&gt;&lt;p&gt;Este código expira en &lt;strong&gt;${expirationMinutes} minutos&lt;/strong&gt;.&lt;/p&gt;&lt;p&gt;Si no solicitaste este restablecimiento, puedes ignorar este correo de forma segura. Tu contraseña permanecerá sin cambios.&lt;/p&gt;&lt;p&gt;&lt;em&gt;Por seguridad, nunca compartas este código con nadie.&lt;/em&gt;&lt;/p&gt;&lt;p&gt;Saludos,&lt;br/&gt;Equipo de Soporte&lt;/p&gt;"/>
        </insert>

        <!-- ============================================================ -->
        <!-- SMS Template (type = 0)                                      -->
        <!-- ============================================================ -->

        <insert tableName="m_template">
            <column name="entity" valueNumeric="0"/>
            <column name="type" valueNumeric="1"/>
            <column name="name" value="SELF_SERVICE_PASSWORD_RESET_REQUESTED_SMS"/>
            <column name="text" value="Hola ${firstname}, tu código para restablecer la contraseña de ${username} es: ${authCode}. Expira en ${expirationMinutes} min. Si no lo solicitaste, ignora este mensaje."/>
        </insert>

        <!-- ============================================================ -->
        <!-- WhatsApp Template (type = 0)                                 -->
        <!-- ============================================================ -->

        <insert tableName="m_template">
            <column name="entity" valueNumeric="0"/>
            <column name="type" valueNumeric="1"/>
            <column name="name" value="SELF_SERVICE_PASSWORD_RESET_REQUESTED_WHATSAPP"/>
            <column name="text" value="🔐 *Restablecimiento de Contraseña*\n\nHola *${firstname}*,\n\nHemos recibido una solicitud para restablecer la contraseña de tu cuenta *${username}*.\n\nTu código de verificación es:\n🔑 *${authCode}*\n\n⏰ Este código expira en *${expirationMinutes} minutos*.\n\nSi no solicitaste este cambio, puedes ignorar este mensaje. Tu contraseña permanecerá segura.\n\n_Por seguridad, nunca compartas este código con nadie._"/>
        </insert>

        <!-- ============================================================ -->
        <!-- In-App Template (type = 0)                                   -->
        <!-- ============================================================ -->

        <insert tableName="m_template">
            <column name="entity" valueNumeric="0"/>
            <column name="type" valueNumeric="1"/>
            <column name="name" value="SELF_SERVICE_PASSWORD_RESET_REQUESTED_IN_APP"/>
            <column name="text" value="Se ha generado un código de verificación para restablecer la contraseña de tu cuenta ${username}. Revisa tu correo electrónico o SMS para obtener el código."/>
        </insert>

        <rollback>
            <delete tableName="m_template">
                <where>
                    name IN (
                        'SELF_SERVICE_PASSWORD_RESET_REQUESTED_EMAIL_SUBJECT',
                        'SELF_SERVICE_PASSWORD_RESET_REQUESTED_EMAIL',
                        'SELF_SERVICE_PASSWORD_RESET_REQUESTED_SMS',
                        'SELF_SERVICE_PASSWORD_RESET_REQUESTED_WHATSAPP',
                        'SELF_SERVICE_PASSWORD_RESET_REQUESTED_IN_APP'
                    )
                </where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
