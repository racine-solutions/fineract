         <column name="entity" valueNumeric="0" />
         <column name="type" valueNumeric="1" />
         <column name="name" value="SELF_SERVICE_SINPE_SUBSCRIPTION_DELETED_SMS" />
         <column name="text" value="Su suscripción SINPE Móvil para ${phoneNumber} ha sido cancelada exitosamente." />
      </insert>
      <insert tableName="m_template">
         <column name="entity" valueNumeric="0" />
         <column name="type" valueNumeric="1" />
         <column name="name" value="SELF_SERVICE_SINPE_SUBSCRIPTION_DELETED_WHATSAPP" />
         <column name="text" value="❌ *Cancelación SINPE*\n\nHola ${firstname}, su suscripción para *${phoneNumber}* ha sido eliminada. Ya no podrá recibir transferencias SINPE en este número." />
      </insert>
      <insert tableName="m_template">
         <column name="entity" valueNumeric="0" />
         <column name="type" valueNumeric="1" />
         <column name="name" value="SELF_SERVICE_SINPE_SUBSCRIPTION_DELETED_IN_APP" />
         <column name="text" value="Su suscripción SINPE Móvil para ${phoneNumber} ha sido cancelada." />
      </insert>
   </changeSet>
</databaseChangeLog>
