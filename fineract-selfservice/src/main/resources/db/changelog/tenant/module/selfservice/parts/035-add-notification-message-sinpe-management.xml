<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
   <!-- 4. Notification Templates for Subscription Lifecycle -->
   <changeSet author="fineract" id="ss-0035-1">
      <comment>SINPE Subscription Lifecycle Templates</comment>
      <!-- CREATED -->
      <insert tableName="m_template">
         <column name="entity" valueNumeric="0" />
         <column name="type" valueNumeric="1" />
         <column name="name" value="SELF_SERVICE_SINPE_SUBSCRIPTION_CREATED_EMAIL_SUBJECT" />
         <column name="text" value="Suscripción SINPE Móvil Creada Exitosamente" />
      </insert>
      <insert tableName="m_template">
         <column name="entity" valueNumeric="0" />
         <column name="type" valueNumeric="1" />
         <column name="name" value="SELF_SERVICE_SINPE_SUBSCRIPTION_CREATED_EMAIL" />
         <column name="text" value="&lt;p&gt;Hola ${firstname},&lt;/p&gt;&lt;p&gt;Su suscripción SINPE Móvil para el número &lt;strong&gt;${phoneNumber}&lt;/strong&gt; ha sido creada exitosamente con el IBAN ${iban}.&lt;/p&gt;" />
      </insert>
      <insert tableName="m_template">
         <column name="entity" valueNumeric="0" />
         <column name="type" valueNumeric="1" />
         <column name="name" value="SELF_SERVICE_SINPE_SUBSCRIPTION_CREATED_SMS" />
         <column name="text" value="Su suscripción SINPE Móvil para ${phoneNumber} ha sido creada exitosamente. IBAN: ${iban}." />
      </insert>
      <insert tableName="m_template">
         <column name="entity" valueNumeric="0" />
         <column name="type" valueNumeric="1" />
         <column name="name" value="SELF_SERVICE_SINPE_SUBSCRIPTION_CREATED_WHATSAPP" />
         <column name="text" value="✅ *Suscripción SINPE Creada*\n\nHola ${firstname}, su suscripción para *${phoneNumber}* ya está activa.\nIBAN: ${iban}" />
      </insert>
      <insert tableName="m_template">
         <column name="entity" valueNumeric="0" />
         <column name="type" valueNumeric="1" />
         <column name="name" value="SELF_SERVICE_SINPE_SUBSCRIPTION_CREATED_IN_APP" />
         <column name="text" value="Su suscripción SINPE Móvil para ${phoneNumber} ha sido creada exitosamente." />
      </insert>
