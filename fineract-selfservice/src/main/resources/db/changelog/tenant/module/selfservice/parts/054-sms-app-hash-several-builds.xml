<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet author="racine" id="ss-0054-sms-app-hash-description">
        <update tableName="c_configuration">
            <column name="description" value="The 11-character hash of each Android mobile app build, separated by commas (debug and Play Store builds have different hashes). When set and enabled they are added to the end of sign-up and password-reset code SMS so the app fills in the code by itself. Leave disabled if you do not know them; members can still type the code."/>
            <where>name = 'self-service-sms-app-hash'</where>
        </update>
    </changeSet>
</databaseChangeLog>
