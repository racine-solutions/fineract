            <column name="grouping" value="communication"/>
            <column name="code" value="READ_COMMTEMPLATE"/>
            <column name="entity_name" value="COMMTEMPLATE"/>
            <column name="action_name" value="READ"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="communication"/>
            <column name="code" value="CREATE_COMMTEMPLATE"/>
            <column name="entity_name" value="COMMTEMPLATE"/>
            <column name="action_name" value="CREATE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="communication"/>
            <column name="code" value="UPDATE_COMMTEMPLATE"/>
            <column name="entity_name" value="COMMTEMPLATE"/>
            <column name="action_name" value="UPDATE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="communication"/>
            <column name="code" value="DELETE_COMMTEMPLATE"/>
            <column name="entity_name" value="COMMTEMPLATE"/>
            <column name="action_name" value="DELETE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="communication"/>
            <column name="code" value="READ_COMMCAMPAIGN"/>
            <column name="entity_name" value="COMMCAMPAIGN"/>
            <column name="action_name" value="READ"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="communication"/>
            <column name="code" value="CREATE_COMMCAMPAIGN"/>
            <column name="entity_name" value="COMMCAMPAIGN"/>
            <column name="action_name" value="CREATE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="communication"/>
            <column name="code" value="UPDATE_COMMCAMPAIGN"/>
            <column name="entity_name" value="COMMCAMPAIGN"/>
            <column name="action_name" value="UPDATE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="communication"/>
            <column name="code" value="SUBMIT_COMMCAMPAIGN"/>
            <column name="entity_name" value="COMMCAMPAIGN"/>
            <column name="action_name" value="SUBMIT"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="communication"/>
            <column name="code" value="APPROVE_COMMCAMPAIGN"/>
            <column name="entity_name" value="COMMCAMPAIGN"/>
            <column name="action_name" value="APPROVE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="communication"/>
            <column name="code" value="REJECT_COMMCAMPAIGN"/>
            <column name="entity_name" value="COMMCAMPAIGN"/>
            <column name="action_name" value="REJECT"/>
