<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <property name="current_datetime" value="NOW()"/>

    <!-- Communication campaigns (RPAY-140): templates, campaigns, runs and per-recipient deliveries -->
    <changeSet id="rpay140-1-tags" author="racine">
        <createTable tableName="m_comm_tag">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints nullable="false" primaryKey="true"/></column>
            <column name="name" type="VARCHAR(50)"><constraints nullable="false" unique="true" uniqueConstraintName="uq_m_comm_tag_name"/></column>
        </createTable>
        <insert tableName="m_comm_tag"><column name="name" value="Loan"/></insert>
        <insert tableName="m_comm_tag"><column name="name" value="Savings"/></insert>
        <insert tableName="m_comm_tag"><column name="name" value="Fixed Deposit"/></insert>
        <insert tableName="m_comm_tag"><column name="name" value="Recurring Deposit"/></insert>
        <insert tableName="m_comm_tag"><column name="name" value="Shares"/></insert>
        <insert tableName="m_comm_tag"><column name="name" value="General"/></insert>
    </changeSet>

    <changeSet id="rpay140-2-template-meta" author="racine">
        <!-- Campaign details a communication template has on top of m_template -->
        <createTable tableName="m_comm_template_meta">
            <column name="template_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" foreignKeyName="fk_comm_template_meta_template" references="m_template(id)" deleteCascade="true"/>
            </column>
            <column name="channel" type="VARCHAR(10)"><constraints nullable="false"/></column>
            <column name="tag" type="VARCHAR(50)"><constraints nullable="false"/></column>
            <column name="purpose" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="email_subject" type="VARCHAR(200)"/>
            <column name="archived" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="created_by" type="BIGINT"/>
            <column name="created_on_utc" type="DATETIME"/>
            <column name="last_modified_by" type="BIGINT"/>
            <column name="last_modified_on_utc" type="DATETIME"/>
        </createTable>
    </changeSet>

    <changeSet id="rpay140-3-campaign" author="racine">
        <createTable tableName="m_comm_campaign">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints nullable="false" primaryKey="true"/></column>
            <column name="name" type="VARCHAR(150)"><constraints nullable="false"/></column>
            <column name="template_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_comm_campaign_template" references="m_template(id)"/>
            </column>
            <column name="channel" type="VARCHAR(10)"><constraints nullable="false"/></column>
            <column name="purpose" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="tag" type="VARCHAR(50)"><constraints nullable="false"/></column>
            <!-- A copy of the template text taken when the campaign is saved: later template edits do not change it -->
            <column name="message_text" type="TEXT"><constraints nullable="false"/></column>
            <column name="email_subject" type="VARCHAR(200)"/>
            <column name="audience_json" type="TEXT"><constraints nullable="false"/></column>
            <column name="schedule_type" type="VARCHAR(10)"><constraints nullable="false"/></column>
            <!-- Tenant local time -->
            <column name="scheduled_at" type="DATETIME"/>
            <column name="next_run_at" type="DATETIME"/>
            <column name="status" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="last_error" type="VARCHAR(500)"/>
            <column name="office_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_comm_campaign_office" references="m_office(id)"/>
            </column>
            <column name="submitted_by" type="BIGINT"/>
            <column name="submitted_on_utc" type="DATETIME"/>
            <column name="approved_by" type="BIGINT"/>
            <column name="approved_on_utc" type="DATETIME"/>
            <column name="rejected_by" type="BIGINT"/>
            <column name="rejected_on_utc" type="DATETIME"/>
            <column name="rejection_reason" type="VARCHAR(500)"/>
            <column name="created_by" type="BIGINT"><constraints nullable="false"/></column>
            <column name="created_on_utc" type="DATETIME"><constraints nullable="false"/></column>
            <column name="last_modified_by" type="BIGINT"><constraints nullable="false"/></column>
            <column name="last_modified_on_utc" type="DATETIME"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="m_comm_campaign" indexName="ix_comm_campaign_status_next_run">
            <column name="status"/>
            <column name="next_run_at"/>
        </createIndex>

        <createTable tableName="m_comm_campaign_history">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints nullable="false" primaryKey="true"/></column>
            <column name="campaign_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_comm_history_campaign" references="m_comm_campaign(id)" deleteCascade="true"/>
            </column>
            <column name="action" type="VARCHAR(30)"><constraints nullable="false"/></column>
            <column name="note" type="VARCHAR(500)"/>
            <column name="user_id" type="BIGINT"/>
            <column name="created_on_utc" type="DATETIME"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="m_comm_campaign_history" indexName="ix_comm_history_campaign">
            <column name="campaign_id"/>
        </createIndex>

        <createTable tableName="m_comm_run">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints nullable="false" primaryKey="true"/></column>
            <column name="campaign_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_comm_run_campaign" references="m_comm_campaign(id)" deleteCascade="true"/>
            </column>
            <column name="run_number" type="INT"><constraints nullable="false"/></column>
            <column name="started_on_utc" type="DATETIME"><constraints nullable="false"/></column>
            <column name="finished_on_utc" type="DATETIME"/>
        </createTable>
        <createIndex tableName="m_comm_run" indexName="ix_comm_run_campaign">
            <column name="campaign_id"/>
        </createIndex>

        <!-- One row per recipient per run: what was sent, to where, and what happened -->
        <createTable tableName="m_comm_delivery">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints nullable="false" primaryKey="true"/></column>
            <column name="run_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_comm_delivery_run" references="m_comm_run(id)" deleteCascade="true"/>
            </column>
            <column name="campaign_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="client_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="channel" type="VARCHAR(10)"><constraints nullable="false"/></column>
            <column name="address" type="VARCHAR(150)"/>
            <column name="message" type="TEXT"/>
            <column name="status" type="VARCHAR(10)"><constraints nullable="false"/></column>
            <column name="reason" type="VARCHAR(30)"/>
            <column name="provider_response" type="VARCHAR(255)"/>
            <column name="attempts" type="INT" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="created_on_utc" type="DATETIME"><constraints nullable="false"/></column>
            <column name="last_attempt_on_utc" type="DATETIME"/>
        </createTable>
        <createIndex tableName="m_comm_delivery" indexName="ix_comm_delivery_run_status">
            <column name="run_id"/>
            <column name="status"/>
        </createIndex>
        <createIndex tableName="m_comm_delivery" indexName="ix_comm_delivery_client">
            <column name="client_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="rpay140-4-marketing-consent" author="racine">
        <!-- A client who asked the SACCO or MFI not to get Sales and marketing messages -->
        <createTable tableName="m_client_marketing_consent">
            <column name="client_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" foreignKeyName="fk_client_marketing_consent_client" references="m_client(id)"/>
            </column>
            <column name="receives_marketing" type="BOOLEAN"><constraints nullable="false"/></column>
            <column name="note" type="VARCHAR(500)"/>
            <column name="changed_by" type="BIGINT"/>
            <column name="changed_on_utc" type="DATETIME"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="rpay140-5-permissions" author="racine">
