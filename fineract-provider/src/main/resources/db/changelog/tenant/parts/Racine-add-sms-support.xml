    <!-- When the low SMS credit banner shows, editable under System > Configurations -->
    <changeSet id="add-sms-credit-low-alert-percent-configuration" author="fineract">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM c_configuration WHERE name = 'sms-credit-low-alert-percent'</sqlCheck>
        </preConditions>
        <insert tableName="c_configuration">
            <column name="name" value="sms-credit-low-alert-percent"/>
            <column name="value" valueNumeric="80"/>
            <column name="date_value"/>
            <column name="string_value"/>
            <column name="enabled" valueBoolean="true"/>
            <column name="is_trap_door" valueBoolean="false"/>
            <column name="description" value="Shows staff an amber low SMS credit banner once this percent of the last SMS top-up is used (1-100). Default 80. Disable to turn the warning off."/>
        </insert>
    </changeSet>
    <changeSet id="add-sms-credit-critical-alert-percent-configuration" author="fineract">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM c_configuration WHERE name = 'sms-credit-critical-alert-percent'</sqlCheck>
        </preConditions>
        <insert tableName="c_configuration">
            <column name="name" value="sms-credit-critical-alert-percent"/>
            <column name="value" valueNumeric="95"/>
            <column name="date_value"/>
            <column name="string_value"/>
            <column name="enabled" valueBoolean="true"/>
            <column name="is_trap_door" valueBoolean="false"/>
            <column name="description" value="Turns the low SMS credit banner red once this percent of the last SMS top-up is used (1-100). Default 95. Disable to turn the red alert off."/>
        </insert>
    </changeSet>

    <!-- Clearer tooltips under System > Configurations; a description the bank has edited is left alone -->
    <changeSet id="clarify-sms-credit-alert-configuration-descriptions" author="fineract">
        <update tableName="c_configuration">
            <column name="description" value="Amber low SMS credit banner: shows once this percent of the last SMS top-up is used, e.g. 80 = warn when 20% is left. Works only while Enabled (Disabled turns this warning off). Blank or outside 1-100 uses 80."/>
            <where>name = 'sms-credit-low-alert-percent' AND description = 'Shows staff an amber low SMS credit banner once this percent of the last SMS top-up is used (1-100). Default 80. Disable to turn the warning off.'</where>
        </update>
        <update tableName="c_configuration">
            <column name="description" value="Red low SMS credit banner: shows once this percent of the last SMS top-up is used, e.g. 95 = red when 5% is left. Works only while Enabled (Disabled turns this alert off). Blank or outside 1-100 uses 95."/>
            <where>name = 'sms-credit-critical-alert-percent' AND description = 'Turns the low SMS credit banner red once this percent of the last SMS top-up is used (1-100). Default 95. Disable to turn the red alert off.'</where>
        </update>
    </changeSet>
    <changeSet id="describe-enable-sms-notifications-configuration" author="fineract">
        <update tableName="c_configuration">
            <column name="description" value="Master switch for every client SMS: loan, savings, fixed and recurring deposit and share updates, and mobile app sign-in codes. When Disabled, clients get no SMS at all and staff see a red warning banner."/>
            <where>name = 'enable-sms-notifications' AND (description IS NULL OR description = '')</where>
        </update>
    </changeSet>

</databaseChangeLog>
